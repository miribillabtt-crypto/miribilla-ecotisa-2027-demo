er">La firma y el archivo SEPA deben conservarse únicamente en el servidor privado definitivo.</p></div>`}`};
function documentsView(rid){let list=docRecords[rid]||[];return `<div class="card"><h3>Mis documentos</h3><div class="boxnote warn">Simulación de captura. Solo se genera una vista previa en esta pestaña; no hay envío ni almacenamiento de la fotografía. No uses DNI o licencias reales para probar.</div><div class="grid2 mt"><div class="field"><label>Tipo de documento</label><select id="docType">${options(['Licencia federativa','Autorización tutor legal','DNI/NIE de prueba','Ficha de inscripción','Mandato SEPA de prueba','Otro'],docsType)}</select></div><div class="field"><label>Cara del documento</label><select id="docSide">${options(['Anverso','Reverso','Una cara'],docsSide)}</select></div></div><div class="filedrop mt"><p style="font-size:28px;margin:0">▣</p><strong>Tomar foto o seleccionar imagen</strong><p class="muted">Busca luz uniforme, fondo plano y cuatro esquinas visibles.</p><input type="file" id="scanInput" accept="image/jpeg,image/png,image/webp" capture="environment"></div>${preview?`<div class="docpreview mt"><img src="${preview.url}" alt="Vista previa de fotografía de prueba" style="transform:rotate(${preview.rotation}deg)"><div class="muted">${enc(preview.name)} · Previsualización local</div></div><div class="actionbar"><button class="btn outline" data-action="rotate-scan">Girar 90°</button><button class="btn" data-action="clear-scan">Repetir</button><button class="btn primary" data-action="confirm-scan">Simular envío</button></div>`:'<p class="muted mt">La corrección automática de perspectiva y el recorte de bordes quedan pendientes de integrar en la versión web definitiva.</p>'}<hr class="rule"><h4>Estado documental · ${list.length} registros de prueba</h4>${list.length?list.map(d=>`<div class="line"><div><strong>${enc(d.type)}</strong><div class="muted">${enc(d.side)} · ${enc(d.name)} · ${enc(d.status)}</div></div><button class="btn outline" data-action="remove-doc" data-id="${d.id}">Eliminar</button></div>`).join(''):'<div class="empty">Sin archivos de prueba registrados.</div>'}</div>`}
views.calls=()=>{if(role==='runner') {let r=currentR();let calls=db.calls.filter(c=>c.riderIds.includes(r.id)&&c.status==='Publicada');return title('Mis convocatorias','Confirma tu asistencia y consulta la información de viaje de tus carreras.')+`<div class="toolbar"><span class="muted">MOSTRAR CONVOCATORIAS COMO</span><select id="riderSelector">${riderOptions()}</select></div>`+(calls.length?`<div class="stack">${calls.map(c=>{let ev=getE(c.eventId),response=c.responses?.[r.id]||'Pendiente';return `<div class="card"><div class="row between"><div><div class="muted">${enc(ev?.category||'Actividad')} · ${enc(ev?.date?formatDate(ev.date):ev?.month||'')}</div><h3 style="margin:6px 0">${enc(ev?.name||'Actividad')}</h3></div>${tag(response)}</div><p class="muted">${enc(c.notes||'Detalles pendientes de dirección deportiva.')}</p><div class="actionbar"><button class="btn ${response==='Confirmado'?'primary':'outline'}" data-action="respond" data-id="${c.id}" data-status="Confirmado">Confirmar asistencia</button><button class="btn ${response==='No disponible'?'primary':'outline'}" data-action="respond" data-id="${c.id}" data-status="No disponible">No disponible</button><button class="btn outline" data-action="view-event" data-id="${c.eventId}">Ver planning</button></div></div>`}).join('')}</div>`:'<div class="empty">No tienes convocatorias publicadas para este corredor.<br><br>Cambia a Dirección para crear y publicar una convocatoria de prueba.</div>')}const optsEvent=options(db.events.map(e=>({value:e.id,label:e.name})),selectedEventId);let c=db.calls.find(c=>c.eventId===selectedEventId);return title('Convocatorias','Selecciona corredores y publica convocatorias para que aparezcan en su área individual.')+`<div class="toolbar"><select id="eventSelector">${optsEvent}</select>${role==='director'?'<button class="btn primary" data-action="edit-call">'+(c?'Editar convocatoria':'Crear convocatoria')+'</button>':''}</div>`+(c?`<div class="grid2"><div class="card"><h3>${enc(getE(c.eventId)?.name||'Convocatoria')}</h3><div class="row between">${tag(c.status)}<span class="muted">${c.riderIds.length} corredores</span></div><hr class="rule">${c.riderIds.map(id=>{let r=getR(id);return `<div class="line"><strong>${enc(r?.name||id)}</strong>${tag(c.responses?.[id]||'Pendiente')}</div>`}).join('')}<div class="actionbar">${role==='director'?'<button class="btn primary" data-action="edit-call">Modificar selección</button>':''}</div></div><div class="card"><h3>Control documental</h3><p class="muted">Estado de las licencias de los convocados. La documentación bancaria y familiar no se muestra.</p>${c.riderIds.map(id=>`<div class="line"><strong>${enc(getR(id)?.name||id)}</strong>${tag(getR(id)?.licenseStatus||'No aportada')}</div>`).join('')}<hr class="rule"><button class="btn outline" data-action="export-call-licenses">Exportar control de licencias</button></div></div>`:'<div class="empty">Todavía no hay convocatoria creada para esta actividad. Dirección puede crearla seleccionando corredores.</div>')};
