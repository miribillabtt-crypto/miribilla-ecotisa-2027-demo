views.schedule=()=>{let show=db.events.filter(ev=>(filterCategory==='Todos'||ev.category===filterCategory)&&(filterMonth==='Todos'||ev.month===filterMonth));let counts=['Carrera','Concentración','Entrenamiento de equipo'].map(cat=>db.events.filter(e=>e.category===cat).length);return title('Calendario 2027','Carreras, concentraciones y entrenamientos de equipo. Las fechas pendientes permanecen sin inventar.')+`<div class="stats">${[[counts[0],'Carreras previstas'],[counts[1],'Concentraciones'],[counts[2],'Entrenamientos'],[show.length,'Actividades visibles']].map(x=>`<div class="stat"><b>${x[0]}</b><span>${x[1]}</span></div>`).join('')}</div><div class="toolbar"><select id="categoryFilter"><option ${filterCategory==='Todos'?'selected':''}>Todos</option><option ${filterCategory==='Carrera'?'selected':''}>Carrera</option><option ${filterCategory==='Concentración'?'selected':''}>Concentración</option><option ${filterCategory==='Entrenamiento de equipo'?'selected':''}>Entrenamiento de equipo</option></select><select id="monthFilter">${options(['Todos','Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre','Sin fecha'],filterMonth)}</select>${role==='director'?'<button class="btn primary push" data-action="new-event">+ Nueva actividad</button>':''}</div>`+(show.length?`<div class="grid3">${show.map(ev=>`<article class="event"><div class="ebar">${tag(ev.category)}${tag(ev.date?formatDate(ev.date):ev.month)}</div><h4>${enc(ev.name)}</h4><p class="muted" style="margin:0">${enc(ev.type||ev.category)} · ${enc(ev.place||'Lugar por confirmar')}</p><p class="muted" style="margin:0">${enc(ev.status||'Programado')} ${ev.owner?'· Gestión: '+enc(ev.owner):''}</p><div class="actions"><button class="btn outline" data-action="view-event" data-id="${ev.id}">Ver detalles</button>${role==='director'?`<button class="btn" data-action="edit-event" data-id="${ev.id}">Editar</button>`:''}</div></article>`).join('')}</div>`:`<div class="e