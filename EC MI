views.profile=()=>{const r=currentR(),p=privateDrafts[r.id]||{};let tabs=[['personal','Datos personales'],['sport','Datos deportivos'],['documents','Mis documentos'],['finance','Cuenta y SEPA']];return title('Mi área personal','En esta demo puedes cambiar de corredor. En la web publicada, cada corredor accederá únicamente a su propia ficha.')+`<div class="toolbar"><span class="muted">CORREDOR DE PRUEBA</span><select id="riderSelector">${riderOptions()}</select></div><div class="profilehead"><div class="avatar">${enc((r.name||'C').slice(0,1))}</div><div><strong style="font-size:20px">${enc(r.name)}</strong><br><small>Júnior · Miribilla × Ecotisa · 2027</small></div></div><div class="seg">${tabs.map(x=>`<button class="btn ${profileTab===x[0]?'active':''}" data-profile-tab="${x[0]}">${x[1]}</button>`).join('')}</div>${profileTab==='personal'?`<div class="card"><h3>Datos personales y contacto</h3><div class="boxnote warn mb">Para la demo utiliza únicamente datos ficticios. Dirección, domicilio y contactos familiares se conservan solo mientras esta página está abierta y no se exportan.</div><form id="personalForm"><div class="grid2">${field('Nombre','displayName',r.name,'text','', 'disabled')}${field('Fecha de nacimiento','birth',p.birth||'','date')}${field('Teléfono','phone',p.phone||'','tel')}${field('Correo electrónico','email',p.email||'','email')}${field('Dirección','address',p.address||'')}${field('Población','city',p.city||'')}${field('Código postal','zip',p.zip||'')}${field('Provincia','province',p.province||'')}</div><div class="section-label">Padres o tutores legales</div><div class="grid2">${field('Nombre primer tutor','guardian1',p.guardian1||'')}${field('Teléfono primer tutor','phone1',p.phone1||'','tel')}${field('Nombre segundo tutor','guardian2',p.guardian2||'')}${field('Teléfono segundo tutor','phone2',p.phone2||'','tel')}</div><div class="actionbar"><button class="btn primary" type="submit">Guardar ficha de prueba</button></div></form></div>`:profileTab=