views.resources=()=>title('Técnicos y vehículos','Control de disponibilidad y asignación en carreras, concentraciones y entrenamientos.')+`<div class="grid2"><div class="card"><div class="row between"><h3>Personal técnico</h3><button class="btn primary" data-action="new-staff">+ Técnico</button></div>${db.staff.length?db.staff.map(s=>`<div class="line"><div><b>${enc(s.name)}</b><div class="muted">${enc(s.role)} · ${enc(s.city||'Base por confirmar')}</div></div>${tag(s.available||'Disponible')}</div>`).join(''):'<div class="empty">Sin técnicos confirmados.<br>Alfonso consta como responsable de invitaciones, no se le asigna aquí automáticamente.</div>'}</div><div class="card"><div class="row between"><h3>Parque móvil</h3><button class="btn primary" data-action="new-vehicle">+ Vehículo</button></div>${db.vehicles.length?db.vehicles.map(v=>`<div class="line"><div><b>${enc(v.name)}</b><div class="muted">${enc(v.type)} · ${enc(v.seats)} plazas · ${enc(v.city||'')}</div></div>${tag(v.available||'Disponible')}</div>`).join(''):'<div class="empty">Sin vehículos registrados.</div>'}</div></div>`;
views.results=()=>title('Resultados y seguimiento','Registro deportivo básico por corredor y actividad; sin datos médicos.')+`<div class="grid2"><div class="card"><h3>Introducir resultado</h3><form id="resultForm" class="stack"><div class="field"><label>Corredor</label><select name="riderId">${riderOptions()}</select></div><div class="field"><label>Carrera</label><select name="eventId">${eventOptions()}</select></div>${field('Puesto','place','','number','Ej. 12','min="1" required')}${field('Días de competición','days','1','number','','min="1"')}${area('Valoración técnica','notes')}<button class="btn primary" type="submit">Guardar resultado</button></form></div><div class="card"><h3>Historial registrado</h3>${db.results.length?db.results.map(res=>`<div class="line"><div><b>${enc(getR(res.riderId)?.name||'')}</b><div class="muted">${enc(getE(res.eventId)?.name||'')} · ${enc(res.notes||'')}</div></div><strong>Puesto ${enc(res.place)}</strong></div>`).join(''):'<div class="empty">Sin resultados aún.</div>'}</div></div>`;
function eventForm(eventId){const original=eventId?getE(eventId):null,ev=original||{name:'',category:'Carrera',month:'Sin fecha',type:'',status:'Por organizar',owner:'',date:'',endDate:'',place:'',manager:'',hotel:'',hotelAddress:'',departureBilbao:'',departureZaragoza:'',meeting:'',plan:''};modal(original?'Editar actividad':'Nueva actividad','Las fechas no facilitadas permanecen pendientes.',`<form id="eventForm"><div class="grid2">${field('Nombre de actividad *','name',ev.name,'text','Carrera, concentración o entrenamiento','required')}${sel('Tipo de actividad','category',ev.category,['Carrera','Concentración','Entrenamiento de equipo'])}${sel('Mes previsto','month',ev.month,['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre','Sin fecha'])}${field('Fecha inicio','date',ev.date,'date')}${field('Fecha fin','endDate',ev.endDate,'date')}${field('Lugar','place',ev.place)}${field('Tipo competición / sesión','type',ev.type,'text','UCI, Copa de España...')}${sel('Estado','status',ev.status,['Por organizar','Inscripción pendiente','Solicitar invitación','Invitación solicitada','Aceptar invitación','Invitación aceptada','Confirmado','Cancelado',ev.status].filter((v,i,a)=>a.indexOf(v)===i))}${field('Responsable de gestión','owner',ev.owner)}</div><div class="actionbar"><button class="btn outline" type="button" data-action="close-modal">Cancelar</button><button class="btn primary" type="submit">Guardar actividad</button></div></form>`);$('#eventForm').onsubmit=e=>{e.preventDefault();let form=Object.fromEntries(new FormData(e.target).entries());if(!form.name.trim())return notify('Introduce el nombre.',true);if(form.date&&form.endDate&&form.endDate<form.date)return notify('La fecha fin es anterior al inicio.',true);if(form.date){let monthNum=Number(form.date.slice(5,7))-1;form.month=['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'][monthNum]||form.month}if(original)Object.assign(original,form);else db.events.push({id:newId('e'),techIds:[],vehicleIds:[],...form});closeModal();render();save()}}
function viewEvent(id){const ev=getE(id);if(!ev)return;modal(ev.name,'Información de la actividad para corredores y técnicos',travelCard(ev)+`<div class="actionbar"><button class="btn outline" data-action="close-modal">Cerrar</button>${role==='director'||role==='technician'?`<button class="btn primary" data-action="edit-travel" data-id="${ev.id}">Editar planning</button>`:''}</div>`)}
function travelForm(eventId){let ev=getE(eventId);if(!ev)return;const check=(kind,fieldName,selected)=>db[kind].length?db[kind].map(it=>`<label class="check"><input name="${fieldName}" value="${it.id}" type="checkbox" ${selected.includes(it.id)?'checked':''}>${enc(it.name)} · ${enc(it.role||it.type||'')}</label>`).join(''):'<p class="muted">No hay recursos registrados por dirección.</p>';modal('Planning · '+ev.name,'Alojamiento, horarios, reunión y disponibilidad de recursos',`<form id="travelForm"><div class="grid2">${field('Fecha salida / inicio','date',ev.date,'date')}${field('Regreso / final','endDate',ev.endDate,'date')}${field('Responsable general','manager',ev.manager)}${field('Lugar','place',ev.place)}${field('Salida Bilbao · fecha y hora','departureBilbao',ev.departureBilbao,'datetime-local')}${field('Salida Zaragoza · fecha y hora','departureZaragoza',ev.departureZaragoza,'datetime-local')}${field('Hotel / alojamiento','hotel',ev.hotel)}${field('Dirección del hotel','hotelAddress',ev.hotelAddress)}${field('Lugar de reunión','meeting',ev.meeting)}</div><div class="mt">${area('Planning diario (comidas, reuniones, carrera, regreso)','plan',ev.plan)}</div><div class="grid2"><div><h4>Técnicos asignados</h4>${check('staff','techIds',ev.techIds)}</div><div><h4>Vehículos asignados</h4>${check('vehicles','vehicleIds',ev.vehicleIds)}</div></div><div class="actionbar"><button class="btn outline" type="button" data-action="close-modal">Cancelar</button><button class="btn primary" type="submit">Guardar planning</button></div></form>`);$('#travelForm').onsubmit=e=>{e.preventDefault();let data=new FormData(e.target),patch=Object.fromEntries(data.entries());patch.techIds=data.getAll('techIds');patch.vehicleIds=data.getAll('vehicleIds');if(patch.date&&patch.endDate&&patch.endDate<patch.date)return notify('La fecha final no puede ser anterior al inicio.',true);if(patch.date&&patch.endDate){let clash=[];for(let other of db.events){if(other.id===ev.id||!other.date||!other.endDate||patch.date>other.endDate||patch.endDate<other.date)continue;for(let id of patch.techIds)if(other.techIds.includes(id))clash.push(db.staff.find(x=>x.id===id)?.name+' ('+other.name+')');for(let id of patch.vehicleIds)if(other.vehicleIds.includes(id))clash.push(db.vehicles.find(x=>x.id===id)?.name+' ('+other.name+')')}if(clash.length)return notify('Solapamiento: '+clash.join(', '),true)}Object.assign(ev,patch);closeModal();render();save()}}
function editCall(){const ev=currentE();let c=db.calls.find(x=>x.eventId===ev.id);const selected=c?.riderIds||[];const statuses=['Borrador','Publicada','Cerrada'];modal('Convocatoria · '+ev.name,'Publicada: aparecerá en la vista individual de los corredores seleccionados.',`<form id="callForm"><div class="grid2">${sel('Estado de la convocatoria','status',c?.status||'Borrador',statuses)}${area('Instrucciones a corredores','notes',c?.notes||'')}</div><h4>Seleccionar corredores</h4><div class="scroll">${db.riders.map(r=>`<label class="check"><input type="checkbox" name="riderIds" value="${r.id}" ${selected.includes(r.id)?'checked':''}>${enc(r.name)} <small class="muted">· maillot ${enc(r.jersey)}</small></label>`).join('')}</div><div class="actionbar"><button class="btn outline" type="button" data-action="close-modal">Cancelar</button><button class="btn primary" type="submit">Guardar convocatoria</button></div></form>`);$('#callForm').onsubmit=e=>{e.preventDefault();let data=new FormData(e.target),ids=data.getAll('riderIds'),status=String(data.get('status')),notes=String(data.get('notes')||'');if(status==='Publicada'&&!ids.length)return notify('Selecciona al menos un corredor.',true);if(c){c.riderIds=ids;c.status=status;c.notes=notes;c.responses=Object.fromEntries(Object.entries(c.responses||{}).filter(([id])=>ids.includes(id)))}else db.calls.push({id:newId('call'),eventId:ev.id,riderIds:ids,status,notes,responses:{}});closeModal();render();save()}}
function staffForm(kind){const isStaff=kind==='staff';modal(isStaff?'Nuevo técnico':'Nuevo vehículo','Registro de recurso del equipo.',`<form id="resourceForm"><div class="grid2">${field('Nombre / identificación *','name','','text','', 'required')}${isStaff?sel('Función','role','Director',['Director','Mecánico','Auxiliar','Responsable general','Otro']):sel('Tipo','type','Furgoneta',['Furgoneta','Coche','Camión','Autobús','Otro'])}${field('Ciudad base','city','','text','Bilbao / Zaragoza')}${isStaff?'':field('Plazas','seats','9','number','','min="1"')}${sel('Disponibilidad','available','Disponible',['Disponible','No disponible','Por confirmar'])}</div><div class="actionbar"><button type="button" class="btn outline" data-action="close-modal">Cancelar</button><button type="submit" class="btn primary">Añadir</button></div></form>`);$('#resourceForm').onsubmit=e=>{e.preventDefault();let val=Object.fromEntries(new FormData(e.target).entries());if(!val.name.trim())return notify('Nombre obligatorio.',true);db[kind].push({id:newId(kind),...val});closeModal();render();save()}}
function downloadHotel(){let ev=currentE(),c=db.calls.find(x=>x.eventId===ev.id);if(!c||!c.riderIds.length)return notify('Primero crea una convocatoria.',true);csv('hotel_'+ev.id+'_prueba.csv',[['Corredor','Competición','Hotel','Llegada','Salida'],...c.riderIds.map(id=>[getR(id)?.name||'',ev.name,ev.hotel||'',ev.date||'',ev.endDate||''])]);notify('Listado de huéspedes exportado, sin DNI ni datos bancarios.')}
function downloadCallLicenses(){let ev=currentE(),c=db.calls.find(x=>x.eventId===ev.id);if(!c||!c.riderIds.length)return notify('Primero crea una convocatoria.',true);csv('licencias_convocatoria_'+ev.id+'.csv',[['Corredor','Estado licencia'],...c.riderIds.map(id=>[getR(id)?.name||'',getR(id)?.licenseStatus||'No aportada'])]);notify('Control de licencias exportado.')}
function handleAction(action,element){let id=element.dataset.id;if(action==='close-modal'){closeModal();return}if(action==='new-event'){eventForm(null);return}if(action==='edit-event'){eventForm(id);return}if(action==='view-event'){viewEvent(id);return}if(action==='edit-travel'){selectedEventId=id||selectedEventId;travelForm(selectedEventId);return}if(action==='edit-call'){editCall();return}if(action==='new-staff'){staffForm('staff');return}if(action==='new-vehicle'){staffForm('vehicles');return}if(action==='export-hotel'){downloadHotel();return}if(action==='export-call-licenses'){downloadCallLicenses();return}if(action==='export-licenses'){csv('panel_licencias_2027.csv',[['Corredor','Talla maillot','Estado licencia'],...db.riders.slice().sort((a,b)=>a.name.localeCompare(b.name,'es')).map(r=>[r.name,r.jersey,r.licenseStatus||'No aportada'])]);notify('CSV de licencias preparado.');return}if(action==='select-rider'){riderId=id;role='runner';section='profile';profileTab='sport';render();return}if(action==='rotate-scan'){if(preview)preview.rotation=(preview.rotation+90)%360;render();return}if(action==='clear-scan'){clearPreview();render();return}if(action==='confirm-scan'){if(!preview)return;let rid=riderId;docRecords[rid]??=[];docRecords[rid].push({id:newId('doc'),name:preview.name,type:docsType,side:docsSide,status:'Captura simulada'});clearPreview();render();notify('Captura simulada registrada. No se ha enviado ningún archivo.');return}if(action==='remove-doc'){docRecords[riderId]=(docRecords[riderId]||[]).filter(d=>d.id!==id);render();return}if(action==='respond'){let c=getCall(id);if(!c||c.status!=='Publicada'||!c.riderIds.includes(riderId))return notify('Convocatoria no disponible.',true);c.responses[riderId]=element.dataset.status;render();save();return}if(action==='import-data'){$('#importInput').click();return}}
function clearPreview(){if(preview?.url)URL.revokeObjectURL(preview.url);preview=null}
function handleForm(e){e.preventDefault();const form=e.target,id=form.id,data=Object.fromEntries(new FormData(form).entries());if(id==='sportForm'){let r=currentR();if(data.saddleHeight&&(Number(data.saddleHeight)<400||Number(data.saddleHeight)>1100))return notify('Altura del sillín fuera de rango, revisa mm.',true);if(data.saddleToBar&&(Number(data.saddleToBar)<200||Number(data.saddleToBar)>1200))return notify('Distancia sillín–manillar fuera de rango, revisa mm.',true);for(let k of ['jersey','bib','helmet','bike','bikeSize','pedals','coach','club','saddleHeight','saddleToBar'])r[k]=data[k]||'';render();save()}else if(id==='personalForm'||id==='financeForm'){privateDrafts[riderId]={...(privateDrafts[riderId]||{}),...data};render();notify('Datos ficticios guardados solo en esta pestaña. No se exportan ni almacenan en disco.')}else if(id==='resultForm'){if(!Number.isFinite(Number(data.place))||Number(data.place)<1)return notify('Introduce una posición válida.',true);db.results.push({id:newId('res'),...data});render();save()}}
// Delegación central de eventos, sin librerías ni dependencias externas.
document.addEventListener('click',e=>{let roleButton=e.target.closest('[data-role]');if(roleButton){switchRole(roleButton.dataset.role);return}let nav=e.target.closest('[data-nav]');if(nav){section=nav.dataset.nav;render();return}let target=e.target.closest('[data-goto]');if(target){section=target.dataset.goto;render();return}let sub=e.target.closest('[data-profile-tab]');if(sub){profileTab=sub.dataset.profileTab;clearPreview();render();return}let btn=e.target.closest('[data-action]');if(btn){handleAction(btn.dataset.action,btn);return}if(e.target.id==='modalback')closeModal()});
document.addEventListener('change',e=>{let t=e.target;if(t.id==='categoryFilter'){filterCategory=t.value;render()}else if(t.id==='monthFilter'){filterMonth=t.value;render()}else if(t.id==='licenseFilter'){licenseFilter=t.value;render()}else if(t.id==='riderSelector'){riderId=t.value;clearPreview();render()}else if(t.id==='eventSelector'){selectedEventId=t.value;render()}else if(t.id==='docType'){docsType=t.value}else if(t.id==='docSide'){docsSide=t.value}else if(t.dataset.license){let r=getR(t.dataset.license);if(r){r.licenseStatus=t.value;r.licenseUpdated=today;render();save()}}else if(t.id==='scanInput'){let file=t.files?.[0];if(!file)return;if(!['image/png','image/jpeg','image/webp'].includes(file.type)||file.size>8*1024*1024){notify('Solo fotos JPG, PNG o WebP de menos de 8 MB para esta demo.',true);return}clearPreview();preview={url:URL.createObjectURL(file),name:file.name,rotation:0};render()}});
document.addEventListener('input',e=>{let el=e.target;const search=(id,cb)=>{if(el.id===id){const pos=el.selectionStart;cb(el.value);let x=$('#'+id);if(x){x.focus();try{x.setSelectionRange(pos,pos)}catch(e){}}return true}return false};if(search('licenseSearch',v=>{licenseSearch=v;$('#licenseRows').innerHTML=licenseRows()}))return;if(search('equipmentSearch',v=>{$('#equipmentRows').innerHTML=equipmentRows(v)}))return;if(search('rosterSearch',v=>{$('#rosterRows').innerHTML=rosterRows(v)}))return});
document.addEventListener('submit',e=>{if(['personalForm','financeForm','sportForm','resultForm'].includes(e.target.id))handleForm(e)});
$('#backupBtn').onclick=exportData;
function importBackup(file){const reader=new FileReader();reader.onload=()=>{try{let data=JSON.parse(reader.result);if(!Array.isArray(data.riders)||!Array.isArray(data.events)||!Array.isArray(data.calls)||!Array.isArray(data.staff)||!Array.isArray(data.vehicles)||!Array.isArray(data.results))throw Error('Estructura no válida');if(!confirm('¿Sustituir los datos de prueba actuales por los del archivo?'))return;let validated=initial();for(const k of ['riders','events','calls','staff','vehicles','results'])validated[k]=data[k];db=validated;selectedEventId=db.events[0]?.id||'';riderId=db.riders[0]?.id||'';clearPreview();render();save();notify('Copia de prueba importada.')}catch(err){notify('No se pudo importar la copia: '+err.message,true)}};reader.readAsText(file)}
// Botón de importación siempre disponible en la zona superior.
const extra=document.createElement('input');extra.type='file';extra.id='importInput';extra.accept='.json,application/json';extra.className='hidden';extra.addEventListener('change',()=>{if(extra.files?.[0])importBackup(extra.files[0]);extra.value='' });document.body.appendChild(extra);
const restoreButton=document.createElement('button');restoreButton.className='linkbtn';restoreButton.textContent='Importar copia';restoreButton.onclick=()=>extra.click();$('#backupBtn').insertAdjacentElement('afterend',restoreButton);
restore();render();
})();
</script></body></html>
